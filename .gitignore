# ============================================================
# GK STUDIO V3 — .gitignore
# ============================================================

# --- Python önbellek ---
__pycache__/
*.pyc
*.pyo
*.pyd

# --- Sanal ortamlar ---
venv/
.venv/
env/

# --- Çevresel değişkenler ---
.env
.env.*
!.env.example

# --- GK Studio meta ve kişisel veriler ---
.gk_studio/
.gk_project_conversation_migrated
chat_history/
conversations/
chats/
chroma_db/
rag_db/
*.sqlite3
*.db

# --- Loglar ---
logs/
*.log

# --- Yedekler ve arşivler ---
_backups/
BACKUPS/
ARCHIVE/
*.bak
*.patch
*.before_*
rag.py.before_*
gateway.py.before_*
ui.js.before_*
websearch.py.before_*

# --- Kullanıcı verileri ---
exports/
excel/
uploads/

# --- Yedek JS/TXT dosyaları ---
static/js/*_backup_*.txt
static/js/*_yedek.txt
static/js/*_backup_*.js
static/js/ui_js_backup_*.js

# --- Editör ---
.idea/
.vscode/
*.swp

# --- OS ---
.DS_Store
Thumbs.db