import { API } from './api.js';
import { State } from './state.js';

export const Workspace = {

  rebuildProjectMap() {
    State.projectConvMap = {};

    const convs = State.conversations || {};

    Object.entries(convs).forEach(([id, conv]) => {
      if (conv && conv.projectName) {
        State.projectConvMap[id] = conv.projectName;
      }
    });
  },

  findExistingProjectConversation(projectName) {
    const convs = State.conversations || {};

    const entries = Object.entries(convs);

    // Once projectName tasiyan mevcut bir sohbet varsa onu yeniden kullan.
    for (const [id, conv] of entries) {
      if (conv && conv.projectName === projectName) {
        return id;
      }
    }

    return null;
  },

  updateActiveBanner(projectName, indexed, chunkCount) {
    const banner = document.getElementById('activeProjectBanner');
    const label = document.getElementById('activeProjectBannerLabel');

    if (!banner || !label) return;

    if (!projectName) {
      banner.style.display = 'none';
      return;
    }

    banner.style.display = 'flex';

    if (indexed) {
      label.textContent =
        `⚡ AKTİF WORKSPACE (RAG): ${projectName} — RAG aktif (${chunkCount || 0} parça)`;
    } else {
      label.textContent =
        `⚡ AKTİF WORKSPACE: ${projectName} — RAG indekslenmemiş`;
    }
  },

  async refreshProjectList(onRender) {
    const listEl = document.getElementById('projectList');

    this.rebuildProjectMap();

    let projects = {};

    try {
      const data = await API.listProjects();
      projects = data.projects || {};
    } catch (e) {
      console.error('Proje listesi okunamadi:', e);
      projects = {};
    }

    if (!listEl) return;

    listEl.innerHTML = '';

    const names = Object.keys(projects);

    if (!names.length) {
      listEl.innerHTML =
        '<div style="color:var(--muted);font-size:.8rem;padding:4px 0;">Henüz proje yok</div>';

      this.updateActiveBanner(State.activeProjectName, false, 0);
      return;
    }

    names.forEach(pName => {

      const proj = projects[pName] || {};
      const isActive = State.activeProjectName === pName;

      const row = document.createElement('div');
      row.className = 'proj-item' + (isActive ? ' active' : '');
      row.style.cssText =
        'padding:6px 0;border-bottom:1px solid var(--border);';

      const header = document.createElement('div');
      header.className = 'proj-header';
      header.style.cssText =
        'display:flex;justify-content:space-between;align-items:center;gap:5px;';

      const title = document.createElement('span');
      title.className = 'proj-title';
      title.textContent = (proj.indexed ? '⚡ ' : '📁 ') + pName;
      title.style.cssText =
        'cursor:pointer;font-size:.85rem;flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';

      title.onclick = () => {
        this.activateProject(pName, onRender);
      };

      header.appendChild(title);

      const toolbar = document.createElement('div');
      toolbar.className = 'proj-toolbar';
      toolbar.style.cssText =
        'display:flex;gap:3px;align-items:center;';

      const runBtn = document.createElement('button');
      runBtn.className = 'proj-btn-action run';
      runBtn.textContent = isActive ? '⏹️' : '▶️';
      runBtn.title = isActive ? 'Workspace kapat' : 'Workspace ac';
      runBtn.style.cssText =
        'background:none;border:none;color:var(--accent);cursor:pointer;padding:2px 4px;';

      runBtn.onclick = (e) => {
        e.stopPropagation();

        if (isActive) {
          this.exitProject(onRender);
        } else {
          this.activateProject(pName, onRender);
        }
      };

      const idxBtn = document.createElement('button');
      idxBtn.className = 'proj-btn-action idx';
      idxBtn.textContent = proj.indexed ? '🔄' : '⚡';
      idxBtn.title = proj.indexed ? 'RAG yeniden indeksle' : 'RAG indeksle';
      idxBtn.style.cssText =
        'background:none;border:none;color:#0d9488;cursor:pointer;padding:2px 4px;';

      idxBtn.onclick = async (e) => {
        e.stopPropagation();

        idxBtn.disabled = true;
        idxBtn.textContent = '⏳';

        try {
          const res = await API.indexProject(pName);

          if (res.status === 'success') {
            alert(
              `✅ ${pName} RAG indekslendi.\n` +
              `${res.file_count} dosya, ${res.chunk_count} parça`
            );

            await this.refreshProjectList(onRender);

            if (State.activeProjectName === pName) {
              await this.activateProject(pName, onRender, true);
            }
          } else {
            alert('İndeks hatasi: ' + (res.message || 'Bilinmeyen hata'));
          }

        } catch (err) {
          alert('RAG indeksleme hatasi: ' + err.message);
        } finally {
          idxBtn.disabled = false;
          idxBtn.textContent = proj.indexed ? '🔄' : '⚡';
        }
      };

      const delBtn = document.createElement('button');
      delBtn.className = 'proj-btn-action del';
      delBtn.textContent = '🗑️';
      delBtn.title = 'Projeyi sil';
      delBtn.style.cssText =
        'background:none;border:none;color:#ef4444;cursor:pointer;padding:2px 4px;';

      delBtn.onclick = async (e) => {
        e.stopPropagation();

        if (!confirm(`"${pName}" projesi silinsin mi?`)) {
          return;
        }

        try {
          const res = await API.deleteProject(pName);

          if (res.status !== 'success') {
            alert('Hata: ' + (res.message || 'Proje silinemedi'));
            return;
          }

          if (State.activeProjectName === pName) {
            this.exitProject(onRender);
          }

          // Silinen projenin conversation map baglantisini temizle.
          Object.keys(State.projectConvMap || {}).forEach(id => {
            if (State.projectConvMap[id] === pName) {
              delete State.projectConvMap[id];
            }
          });

          await this.refreshProjectList(onRender);

          if (onRender) {
            onRender();
          }

        } catch (err) {
          alert('Proje silme hatasi: ' + err.message);
        }
      };

      toolbar.appendChild(runBtn);
      toolbar.appendChild(idxBtn);
      toolbar.appendChild(delBtn);

      row.appendChild(header);
      row.appendChild(toolbar);

      listEl.appendChild(row);
    });

    if (State.activeProjectName) {
      const activeProject = projects[State.activeProjectName];

      this.updateActiveBanner(
        State.activeProjectName,
        !!activeProject?.indexed,
        activeProject?.indexed_chunk_count || 0
      );
    } else {
      this.updateActiveBanner(null, false, 0);
    }
  },

  async activateProject(pName, onRender, silent = false) {

    // Once map'i yenile.
    this.rebuildProjectMap();

    let projects = {};

    try {
      const data = await API.listProjects();
      projects = data.projects || {};
    } catch (e) {
      console.error('Proje bilgisi okunamadi:', e);
    }

    const proj = projects[pName] || {};

    // Ayni proje icin daha once olusturulmus sohbet varsa onu kullan.
    let id = this.findExistingProjectConversation(pName);

    if (!id) {
      id = String(State.nextId++);

      State.conversations[id] = {
        title: '📂 ' + pName,
        projectName: pName,
        model:
          document.getElementById('modelSelect')?.value ||
          proj.default_model ||
          'auto',
        created: Date.now(),
        isGenerating: false,
        pending: false,
        messages: [
          {
            role: 'assistant',
            content:
              `⚡ **"${pName}"** RAG çalışma alanı aktif edildi.\n\n` +
              `Proje sohbeti kalıcı olarak bu workspace ile bağlantılıdır.`
          }
        ]
      };
    } else {
      const conv = State.conversations[id];

      // Eski sohbetlerde projectName eksikse tamamla.
      if (conv && !conv.projectName) {
        conv.projectName = pName;
      }

      // Eski bozuk generating/pending durumlarını temizle.
      if (conv) {
        conv.isGenerating = false;
        conv.pending = false;
        conv.abortCtrl = null;
      }
    }

    State.activeProjectName = pName;
    State.currentId = id;

    State.projectConvMap[id] = pName;

    // RAG bilgilerini dinamik olarak sakla.
    State.activeProjectPath = proj.path || null;
    State.activeProjectIndexed = !!proj.indexed;
    State.activeProjectChunkCount = proj.indexed_chunk_count || 0;

    State.saveToStorage();

    try {
      await API.saveConversations(
        State.conversations,
        State.currentId,
        State.nextId
      );
    } catch (e) {
      console.warn('Sohbet kaydi gonderilemedi:', e);
    }

    this.updateActiveBanner(
      pName,
      !!proj.indexed,
      proj.indexed_chunk_count || 0
    );

    await this.refreshProjectList(onRender);

    if (onRender) {
      onRender();
    }

    if (!silent) {
      console.log(
        `[WORKSPACE] Aktif proje: ${pName} | Sohbet: ${id} | RAG: ${!!proj.indexed}`
      );
    }

    return id;
  },

  exitProject(onRender) {
    State.activeProjectName = null;
    State.activeProjectPath = null;
    State.activeProjectIndexed = false;
    State.activeProjectChunkCount = 0;

    const banner = document.getElementById('activeProjectBanner');

    if (banner) {
      banner.style.display = 'none';
    }

    this.refreshProjectList(onRender);

    if (onRender) {
      onRender();
    }
  },

  initWorkspaceUI(onRender) {

    const addBtn = document.getElementById('addProjectBtn');

    if (addBtn) {
      addBtn.onclick = async () => {

        const name = prompt('Proje / Çalışma Alanı Adı:');

        if (!name) return;

        const path = prompt(
          'Klasör Dizin Yolu (örn: C:\\Projelerim\\Muhasebe):'
        );

        if (!path) return;

        try {
          const res = await API.addProject(
            name.trim(),
            path.trim(),
            'auto'
          );

          if (res.status === 'success') {
            await this.activateProject(name.trim(), onRender);
          } else {
            alert('Hata: ' + (res.message || 'Proje eklenemedi'));
          }

        } catch (e) {
          alert('Proje ekleme hatasi: ' + e.message);
        }
      };
    }

    const exitBtn = document.getElementById('exitWorkspaceBtn');

    if (exitBtn) {
      exitBtn.onclick = () => {
        this.exitProject(onRender);
      };
    }

    this.rebuildProjectMap();

    // Daha once acik olan proje sohbetini tekrar bagla.
    if (State.currentId && State.conversations[State.currentId]) {

      const currentConv = State.conversations[State.currentId];

      if (currentConv.projectName) {
        State.activeProjectName = currentConv.projectName;
        State.projectConvMap[State.currentId] = currentConv.projectName;
      }
    }

    this.refreshProjectList(onRender);
  }
};